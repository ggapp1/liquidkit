# liquidprompt configuration.
# Installed to ~/.config/liquidpromptrc by install.sh.

# --- noise reduction ---------------------------------------------------------
LP_USER_ALWAYS=0          # hide username when it is the local user
LP_HOSTNAME_ALWAYS=-1     # hide hostname unless connected over SSH
LP_PATH_LENGTH=35
LP_PATH_KEEP=2

# --- signals worth having ----------------------------------------------------
LP_ENABLE_RUNTIME=1
LP_RUNTIME_THRESHOLD=2
LP_ENABLE_TIME=1
LP_TIME_ANALOG=0          # digital clock rather than the analog glyph
# LP_TIME_ANALOG only chooses digital vs analog - it does NOT drop the seconds.
# The format is a separate variable defaulting to "%H:%M:%S" (liquidprompt:387),
# so removing seconds means setting it explicitly.
LP_TIME_FORMAT="%H:%M"
LP_ENABLE_SUDO_CACHE=1
LP_ENABLE_GIT_UNTRACKED_FILES=1
LP_ENABLE_JOBS=1

# --- system info -------------------------------------------------------------
# NOTE: the variable is LP_ENABLE_BATT, not LP_ENABLE_BATTERY.
# LP_ENABLE_BATTERY appears nowhere in liquidprompt, so setting it does nothing
# and the battery segment stays visible. This cost an hour to find once already.
LP_ENABLE_BATT=0
LP_ENABLE_LOAD=0
LP_ENABLE_TEMP=0

# --- virtualenv / conda ------------------------------------------------------
LP_ENABLE_VIRTUALENV=1
# conda activates 'base' in every shell, so showing it is pure noise.
# Hide that one name; any other environment still displays.
#
# This MUST be re-evaluated on every prompt, not once while this file is being
# sourced. conda's init block lives in ~/.zshrc.local, which zsh/zshrc sources
# AFTER zsh/60-prompt.zsh -- so at the moment this file runs CONDA_DEFAULT_ENV
# does not exist yet and a one-shot check always sees "not base" and shows it.
# liquidprompt re-reads LP_ENABLE_VIRTUALENV on every prompt
# (liquidprompt:1992), so a precmd hook is enough. Registering it from here
# also guarantees it runs before liquidprompt's own __lp_set_prompt, which is
# appended later during liquidprompt's init.
_lp_hide_conda_base() {
  if [[ "${CONDA_DEFAULT_ENV:-}" == "base" ]]; then
    LP_ENABLE_VIRTUALENV=0
  else
    LP_ENABLE_VIRTUALENV=1
  fi
}
if [[ -n "${precmd_functions+set}" ]] || typeset -a precmd_functions; then
  precmd_functions+=(_lp_hide_conda_base)
fi

# --- VCS text colours --------------------------------------------------------
# liquidprompt colours the branch text itself, independently of the powerline
# segment around it: LP_COLOR_UP defaults to $GREEN (liquidprompt:562) and is
# applied at liquidprompt:2737. The powerline theme does not override it. The
# result is green text on the bright-green clean-VCS background -- the segment
# looks empty. Same class of clash for the other states.
#
# Pin them all to the segment's own foreground (232, near-black), which is
# legible on every background this theme uses for VCS: 84 green (clean),
# 208 orange (dirty), 141 purple (stash).
#
# Note the empty string is NOT an option: liquidprompt reads these with
# ${VAR:-default}, so an empty value falls straight back to the default colour.
LP_COLOR_UP=$'\e[38;5;232m'
LP_COLOR_COMMITS=$'\e[38;5;232m'
LP_COLOR_CHANGES=$'\e[38;5;232m'
LP_COLOR_DIFF=$'\e[38;5;232m'

# --- powerline glyphs --------------------------------------------------------
# These MUST contain real Private Use Area characters. They were once stripped
# to empty strings, which silently fell back to theme defaults.
# Requires a Nerd Font (see iterm2/Profile.json).
POWERLINE_HARD_DIVIDER=""          # U+E0B0
POWERLINE_SOFT_DIVIDER=""          # U+E0B1
POWERLINE_VCS_MARKER=""            # U+E0A0
POWERLINE_PYTHON_ENV_MARKER=" "    # U+E73C + space

# --- Dracula-inspired palette ------------------------------------------------
# Format: (FG_256 BG_256 bold underline FG_8_fallback BG_8_fallback)
# Must be set BEFORE lp_theme is invoked.
#
# NOTE: every dark-foreground segment (fg 232) deliberately has bold OFF.
# Terminals with "brighten bold text" enabled - it is ON by default in iTerm2
# ("Use Bright Bold") - render bold text with a lightened foreground. Applied
# to a near-black fg that turns it grey, and grey on a bright background such
# as #5fff87 (the clean-VCS green) is close to unreadable. The measured
# contrast still looks excellent on paper (15:1) because the palette says
# #080808; the terminal simply never draws it that way. Light-on-dark segments
# are unaffected, since brightening white leaves it white.
POWERLINE_NEUTRAL_COLOR=(252 236 0 0 7 0)
POWERLINE_TIME_COLOR=(232 141 0 0 0 5)
POWERLINE_JOBS_COLOR=(232 220 0 0 0 3)
POWERLINE_USER_COLOR=(232 117 0 0 0 6)
POWERLINE_HOST_COLOR=(232 212 0 0 0 5)
POWERLINE_PATH_COLOR=(255 17 0 0 7 4)
POWERLINE_PATH_SEPARATOR_COLOR=(123 17 0 0 7 6)
POWERLINE_PATH_LAST_COLOR=(255 17 0 0 7 4)
POWERLINE_PATH_SHORTENED_COLOR=(255 17 0 0 7 4)
POWERLINE_PATH_VCS_COLOR=(255 17 0 0 7 4)
POWERLINE_PYTHON_ENV_COLOR=(232 84 0 0 0 2)
POWERLINE_NODE_ENV_COLOR=(232 215 0 0 0 3)
POWERLINE_VCS_CLEAN_COLOR=(232 84 0 0 0 2)
POWERLINE_VCS_DIRTY_COLOR=(232 208 0 0 0 3)
POWERLINE_VCS_STASH_COLOR=(232 141 0 0 0 5)
POWERLINE_RUNTIME_COLOR=(232 220 0 0 0 3)
POWERLINE_ERROR_COLOR=(231 88 1 0 7 1)

# --- theme activation --------------------------------------------------------
# LP_THEME alone is NOT enough. liquidprompt calls `lp_theme "$LP_THEME"` for us,
# but that call is wrapped in `>/dev/null 2>&1` and the powerline theme's
# activation function only exists once its theme file has been sourced. Set
# LP_THEME without sourcing the file and the activation fails SILENTLY: no bar,
# no colours, just the bare input mark, with nothing printed to say why.
_lp_powerline_theme="${LIQUIDPROMPT_DIR:-$HOME/.local/share/liquidprompt}/themes/powerline/powerline.theme"
if [[ -r "$_lp_powerline_theme" ]]; then
  source "$_lp_powerline_theme"
  # Setting LP_THEME is NOT sufficient on its own, and sourcing the theme file
  # is not either. lp_theme must be called explicitly here, while the config is
  # being sourced. Without this call liquidprompt falls back to its default
  # bracket theme -- `[user:/path]` -- and every POWERLINE_* colour above is
  # silently ignored, with nothing printed to explain why.
  lp_theme powerline_full
fi
unset _lp_powerline_theme

LP_THEME=powerline_full
